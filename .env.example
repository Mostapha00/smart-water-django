# Copier ce fichier en .env puis adapter. Ne JAMAIS committer .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 16 (laisser POSTGRES_DB vide pour utiliser SQLite en développement)
POSTGRES_DB=
POSTGRES_USER=aquamind
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Modèle IA de risque de panne entraîné hors ligne (joblib). Vide = règle de base.
AQUAMIND_FAILURE_MODEL_PATH=
